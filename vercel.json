{
  "regions": ["icn1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self)" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
